{
  "manifest_version": 2,
  "name": "Clarity.AI",
  "author": "roy.biswajeet161@gmail.com",
  "version": "0.0.2",
  "description": "Real-time audio separation for vocals and accompaniment from streaming audio.",
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "tabCapture",
    "background"
  ],
  "background": {
    "page": "background.html",
    "persistent": true
  },
  "browser_action": {
    "default_title": "Clarity AI - Audio Separation",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "browser_style": true,
    "chrome_style": true
  },
  "web_accessible_resources": [
    "scripts/*.mjs",
    "scripts/*.wasm",
    "scripts/ort-wasm-simd-threaded.jsep.mjs",
    "models/UVR-MDX-NET-Inst_HQ_3.onnx",
    "stream-worklet.js"
  ],
  "content_security_policy": "script-src 'self' 'wasm-eval' 'unsafe-eval' blob: filesystem:; object-src 'self'; worker-src 'self' blob:;"
}